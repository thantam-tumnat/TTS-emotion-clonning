# ==============================================================================
# Thai TTS Tone Annotation & Voice Cloning - Environment Variables Template
# ==============================================================================

# LLM Provider Selection: "gemini", "openai", or "anthropic"
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. Google Gemini (Google AI Studio: https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ESCALATE_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 2. 9arm Gateway / OpenAI-Compatible API (https://gateway.9arm.co)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_or_9arm_api_key_here
OPENAI_BASE_URL=https://gateway.9arm.co/v1
OPENAI_MODEL=qwen3.8-27b-fp8

# ------------------------------------------------------------------------------
# 3. Anthropic Claude (https://console.anthropic.com/) - Optional
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_ESCALATE_MODEL=claude-sonnet-5

# ------------------------------------------------------------------------------
# 4. Pipeline & Central Model Service Settings
# ------------------------------------------------------------------------------
MAX_SEGMENTS=20
REANCHOR_CHARS=
SEGMENTER_ENGINE=crfcut

# Central VoxCPM2 Model Service (Port 8000) & Tone Studio Port (Port 8011)
VOXCPM_SERVICE_URL=http://127.0.0.1:8000
SERVICE_PORT=8011

