# LLM Provider: gemini (Google AI Studio) or anthropic
LLM_PROVIDER=gemini

# Google AI Studio API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ESCALATE_MODEL=gemini-2.5-pro

# Anthropic Claude API Key (optional if using Gemini)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_ESCALATE_MODEL=claude-sonnet-5

# Pipeline Settings
MAX_SEGMENTS=20
REANCHOR_CHARS=
SEGMENTER_ENGINE=crfcut

# SiangTTS / VoxCPM2
SIANGTTS_BASE_MODEL=openbmb/VoxCPM2
SIANGTTS_ADAPTER=dubbing-ai/SiangTTS-VoxCPM2-Thai-LoRA
# Blank = auto (prefers CUDA). VoxCPM2 needs ~8GB VRAM; use "cpu" if the GPU is busy.
SIANGTTS_DEVICE=
# ZipEnhancer denoiser: unused by this pipeline, costs memory to load.
SIANGTTS_LOAD_DENOISER=false
# torch.compile warm-up: faster steady-state, slow/fragile start on Windows.
SIANGTTS_OPTIMIZE=false
# Emit a 440Hz test tone instead of failing when the model can't load. Tests only.
SIANGTTS_ALLOW_MOCK=false
